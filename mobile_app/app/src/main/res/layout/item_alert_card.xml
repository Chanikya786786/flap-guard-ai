<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_alert"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/fg_surface"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/fg_border"
    app:strokeWidth="1dp">

    <LinearLayout android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="vertical" android:padding="14dp">

        <LinearLayout android:gravity="center_vertical" android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="horizontal">

            <TextView android:id="@+id/tv_alert_patient" android:layout_height="wrap_content" android:layout_weight="1" android:layout_width="0dp" android:text="Patient Name" android:textColor="@color/fg_text_primary" android:textSize="15sp" android:textStyle="bold"/>

            <TextView android:background="@drawable/bg_badge" android:id="@+id/tv_alert_tier" android:layout_height="wrap_content" android:layout_width="wrap_content" android:paddingBottom="3dp" android:paddingEnd="10dp" android:paddingStart="10dp" android:paddingTop="3dp" android:text="CRITICAL" android:textSize="11sp" android:textStyle="bold"/>
        </LinearLayout>

        <TextView android:id="@+id/tv_alert_message" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:layout_width="match_parent" android:text="Alert message" android:textColor="@color/fg_text_secondary" android:textSize="13sp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_ack_alert"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:text="Acknowledge Alert"
            android:textAllCaps="false"
            android:textSize="12sp"
            app:backgroundTint="@color/fg_danger"
            app:cornerRadius="10dp" />

        <TextView android:id="@+id/tv_alert_acked_by" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_width="wrap_content" android:text="Acknowledged" android:textColor="@color/fg_success" android:textSize="12sp" android:textStyle="bold" android:visibility="gone"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
