<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fg_bg"
    android:orientation="vertical">

    <!-- Sticky Flat Clinical Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/fg_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="10dp"
        android:paddingEnd="8dp"
        android:paddingBottom="10dp">

        <ImageButton
            android:id="@+id/btn_chart_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back to Ward"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            app:tint="@color/fg_text_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_sheet_patient_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Patient Name"
                android:textColor="@color/fg_text_primary"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/tv_sheet_patient_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:text="MRN-2026-102 • 47y • 16.5h post-op"
                android:textColor="@color/fg_text_muted"
                android:textSize="11.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_sheet_risk_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="2dp"
            android:background="@drawable/bg_badge"
            android:paddingStart="10dp"
            android:paddingTop="3.5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3.5dp"
            android:text="Healthy"
            android:textColor="@color/fg_success"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_chart_more"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="More chart options"
            android:padding="6dp"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/fg_text_secondary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/fg_divider" />

    <!-- Scrollable Flat Clinical Chart -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="16dp">

            <!-- 1. Unified Clinical Status & Guidance Sheet -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_chart_guidance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@color/fg_surface"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/fg_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/tv_sheet_flap_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Fibula Osteocutaneous Flap — Right Mandibular Reconstruction"
                        android:textColor="@color/fg_text_primary"
                        android:textSize="13.5sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_detail_schedule"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_badge"
                            android:fontFamily="sans-serif-medium"
                            android:fontFeatureSettings="tnum"
                            android:paddingStart="8dp"
                            android:paddingTop="2.5dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="2.5dp"
                            android:text=""
                            android:textColor="@color/fg_accent"
                            android:textSize="10.5sp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tv_detail_trend_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_badge"
                            android:backgroundTint="@color/fg_primary_soft"
                            android:paddingStart="8dp"
                            android:paddingTop="2.5dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="2.5dp"
                            android:text="Stable"
                            android:textColor="@color/fg_primary_text"
                            android:textSize="10.5sp" />

                        <TextView
                            android:id="@+id/tv_detail_conf_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge"
                            android:backgroundTint="@color/fg_surface_soft"
                            android:paddingStart="8dp"
                            android:paddingTop="2.5dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="2.5dp"
                            android:text="High"
                            android:textColor="@color/fg_text_secondary"
                            android:textSize="10.5sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_detail_ood_warning"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_metric_tile"
                        android:backgroundTint="@color/fg_warning_bg"
                        android:fontFamily="sans-serif-medium"
                        android:padding="9dp"
                        android:text="Probe artifact / out-of-distribution reading — verify sensor contact at bedside."
                        android:textColor="@color/fg_warning"
                        android:textSize="11.5sp"
                        android:visibility="gone" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="9dp"
                        android:background="@color/fg_divider" />

                    <TextView
                        android:id="@+id/tv_detail_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingMultiplier="1.2"
                        android:text=""
                        android:textColor="@color/fg_text_primary"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. Flat 4-Column Tabular Vitals Bar (Zero Nested Boxes) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@color/fg_surface"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/fg_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="11dp"
                    android:paddingBottom="11dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ΔT"
                            android:textColor="@color/fg_text_muted"
                            android:textSize="10.5sp" />

                        <TextView
                            android:id="@+id/tv_detail_delta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif-medium"
                            android:fontFeatureSettings="tnum"
                            android:text="--"
                            android:textColor="@color/fg_text_primary"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="&lt; 1.5°C"
                            android:textColor="@color/fg_text_muted"
                            android:textSize="9.5sp" />
                    </LinearLayout>

                    <View android:layout_width="1dp" android:layout_height="34dp" android:layout_gravity="center_vertical" android:background="@color/fg_divider" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SpO₂"
                            android:textColor="@color/fg_text_muted"
                            android:textSize="10.5sp" />

                        <TextView
                            android:id="@+id/tv_detail_spo2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif-medium"
                            android:fontFeatureSettings="tnum"
                            android:text="--"
                            android:textColor="@color/fg_text_primary"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="&gt; 92%"
                            android:textColor="@color/fg_text_muted"
                            android:textSize="9.5sp" />
                    </LinearLayout>

                    <View android:layout_width="1dp" android:layout_height="34dp" android:layout_gravity="center_vertical" android:background="@color/fg_divider" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.15"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Doppler"
                            android:textColor="@color/fg_text_muted"
                            android:textSize="10.5sp" />

                        <TextView
                            android:id="@+id/tv_detail_doppler"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif-medium"
                            android:fontFeatureSettings="tnum"
                            android:text="--"
                            android:textColor="@color/fg_text_primary"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="&gt; 15 cm/s"
                            android:textColor="@color/fg_text_muted"
                            android:textSize="9.5sp" />
                    </LinearLayout>

                    <View android:layout_width="1dp" android:layout_height="34dp" android:layout_gravity="center_vertical" android:background="@color/fg_divider" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.95"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Visual"
                            android:textColor="@color/fg_text_muted"
                            android:textSize="10.5sp" />

                        <TextView
                            android:id="@+id/tv_detail_visual"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif-medium"
                            android:fontFeatureSettings="tnum"
                            android:text="--"
                            android:textColor="@color/fg_text_primary"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="/ 100"
                            android:textColor="@color/fg_text_muted"
                            android:textSize="9.5sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. Native-Scale Perfusion Trajectory (Visible Above the Fold) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@color/fg_surface"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/fg_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="13dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="Perfusion Trajectory"
                            android:textColor="@color/fg_text_primary"
                            android:textSize="14.5sp" />

                        <TextView
                            android:id="@+id/tv_chart_threshold_hint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:text="Alert &lt; 90%"
                            android:textColor="@color/fg_danger"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:layout_marginBottom="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tab_metric_spo2"
                            android:layout_width="0dp"
                            android:layout_height="30dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pill_outline"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:text="SpO₂"
                            android:textSize="11.5sp" />

                        <TextView
                            android:id="@+id/tab_metric_delta"
                            android:layout_width="0dp"
                            android:layout_height="30dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pill_outline"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:text="ΔT °C"
                            android:textSize="11.5sp" />

                        <TextView
                            android:id="@+id/tab_metric_doppler"
                            android:layout_width="0dp"
                            android:layout_height="30dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pill_outline"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:text="Doppler"
                            android:textSize="11.5sp" />

                        <TextView
                            android:id="@+id/tab_metric_risk"
                            android:layout_width="0dp"
                            android:layout_height="30dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pill_outline"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:text="AI Risk"
                            android:textSize="11.5sp" />
                    </LinearLayout>

                    <com.flapguard.ai.TrendChartView
                        android:id="@+id/view_trend_chart"
                        android:layout_width="match_parent"
                        android:layout_height="190dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4. Bedside Physical Exam (Shown Only If Recorded) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_chart_exam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/fg_surface"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/fg_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="13dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="LATEST BEDSIDE EXAM"
                        android:textColor="@color/fg_text_muted"
                        android:textSize="10.5sp" />

                    <LinearLayout
                        android:id="@+id/ll_chart_exam_rows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 5. Chronological Assessment Log -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/fg_surface"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/fg_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="13dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Assessment Log"
                        android:textColor="@color/fg_text_primary"
                        android:textSize="14.5sp" />

                    <TextView
                        android:id="@+id/tv_recent_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Loading assessment timeline..."
                        android:textColor="@color/fg_text_muted"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/ll_recent_readings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Safe Sticky Footer (Archive Moved to Top Overflow Menu) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/fg_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/fg_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_chart_outcome"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="0.95"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Log Outcome"
            android:textAllCaps="false"
            android:textColor="@color/fg_primary_text"
            android:textSize="13.5sp"
            app:cornerRadius="10dp"
            app:strokeColor="@color/fg_border_strong" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_sheet_assess"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1.35"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Assess Flap"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@color/fg_primary"
            app:cornerRadius="10dp" />
    </LinearLayout>
</LinearLayout>
