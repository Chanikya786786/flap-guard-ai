<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fg_bg"
    android:orientation="vertical">

    <!-- Sticky Clinical Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/fg_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btn_chart_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back to Ward"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            app:tint="@color/fg_text_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_sheet_patient_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Patient Name"
                android:textColor="@color/fg_text_primary"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tv_sheet_patient_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MRN-2026-102 • 47y • 16.5h post-op"
                android:textColor="@color/fg_text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_sheet_risk_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge"
            android:paddingStart="11dp"
            android:paddingTop="4dp"
            android:paddingEnd="11dp"
            android:paddingBottom="4dp"
            android:text="Healthy"
            android:textColor="@color/fg_success"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/fg_divider" />

    <!-- Scrollable Clinical Chart Body -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Clinical Context & Protocol Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/fg_surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/fg_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_sheet_flap_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Fibula Osteocutaneous Flap — Right Mandibular Reconstruction"
                        android:textColor="@color/fg_text_primary"
                        android:textSize="14sp" />

                    <!-- Prominent Monitoring Schedule Pill -->
                    <TextView
                        android:id="@+id/tv_detail_schedule"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_badge"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:text=""
                        android:textColor="@color/fg_accent"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <!-- Trend & Reliability Strip -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_detail_trend_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_badge"
                            android:backgroundTint="@color/fg_primary_soft"
                            android:paddingStart="9dp"
                            android:paddingTop="3dp"
                            android:paddingEnd="9dp"
                            android:paddingBottom="3dp"
                            android:text="Trend: Stable"
                            android:textColor="@color/fg_primary_text"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tv_detail_conf_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge"
                            android:backgroundTint="@color/fg_surface_soft"
                            android:paddingStart="9dp"
                            android:paddingTop="3dp"
                            android:paddingEnd="9dp"
                            android:paddingBottom="3dp"
                            android:text="Reliability: High"
                            android:textColor="@color/fg_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- OOD Probe Warning -->
                    <TextView
                        android:id="@+id/tv_detail_ood_warning"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_metric_tile"
                        android:backgroundTint="@color/fg_danger_bg"
                        android:fontFamily="sans-serif-medium"
                        android:padding="10dp"
                        android:text="Out-of-distribution sensor reading detected — verify probe placement at bedside."
                        android:textColor="@color/fg_danger"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2x2 Latest Bedside Vitals Grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_box"
                    android:orientation="vertical"
                    android:padding="13dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Temp Drop (ΔT)"
                        android:textColor="@color/fg_text_muted"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_detail_delta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="--"
                        android:textColor="@color/fg_text_primary"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Normal &lt; 1.5°C"
                        android:textColor="@color/fg_text_muted"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_box"
                    android:orientation="vertical"
                    android:padding="13dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tissue SpO₂"
                        android:textColor="@color/fg_text_muted"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_detail_spo2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="--"
                        android:textColor="@color/fg_text_primary"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Normal &gt; 92%"
                        android:textColor="@color/fg_text_muted"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_box"
                    android:orientation="vertical"
                    android:padding="13dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Doppler Flow"
                        android:textColor="@color/fg_text_muted"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_detail_doppler"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="--"
                        android:textColor="@color/fg_text_primary"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Normal &gt; 15 cm/s"
                        android:textColor="@color/fg_text_muted"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_box"
                    android:orientation="vertical"
                    android:padding="13dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Visual Perfusion"
                        android:textColor="@color/fg_text_muted"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_detail_visual"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="--"
                        android:textColor="@color/fg_text_primary"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="CIE-LAB Score"
                        android:textColor="@color/fg_text_muted"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Clinical Action Guidance Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_chart_guidance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/fg_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/fg_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="CLINICAL GUIDANCE"
                        android:textColor="@color/fg_text_muted"
                        android:textSize="10.5sp" />

                    <TextView
                        android:id="@+id/tv_detail_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:lineSpacingMultiplier="1.2"
                        android:text=""
                        android:textColor="@color/fg_text_primary"
                        android:textSize="13.5sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Structured Bedside Physical Exam Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_chart_exam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/fg_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/fg_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="LATEST BEDSIDE PHYSICAL EXAM"
                        android:textColor="@color/fg_text_muted"
                        android:textSize="10.5sp" />

                    <LinearLayout
                        android:id="@+id/ll_chart_exam_rows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Interactive Native-Scale Perfusion Trend Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/fg_surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/fg_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="Perfusion Trajectory"
                            android:textColor="@color/fg_text_primary"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tv_chart_threshold_hint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Alert &lt; 90%"
                            android:textColor="@color/fg_danger"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- 4 Native-Scale Metric Selector Tabs -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tab_metric_spo2"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pill_outline"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:text="SpO₂"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tab_metric_delta"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pill_outline"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:text="ΔT °C"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tab_metric_doppler"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pill_outline"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:text="Doppler"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tab_metric_risk"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pill_outline"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:text="AI Risk"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.flapguard.ai.TrendChartView
                        android:id="@+id/view_trend_chart"
                        android:layout_width="match_parent"
                        android:layout_height="196dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Recent Assessments Log Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/fg_surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/fg_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Recent Assessments"
                        android:textColor="@color/fg_text_primary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tv_recent_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Loading assessment timeline..."
                        android:textColor="@color/fg_text_muted"
                        android:textSize="12.5sp" />

                    <LinearLayout
                        android:id="@+id/ll_recent_readings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Sticky Clinical Action Footer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/fg_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/fg_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_sheet_remove"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Archive"
            android:textAllCaps="false"
            android:textColor="@color/fg_danger"
            android:textSize="13sp"
            app:cornerRadius="12dp"
            app:strokeColor="@color/fg_danger_border" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_chart_outcome"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Outcome"
            android:textAllCaps="false"
            android:textColor="@color/fg_primary_text"
            android:textSize="13sp"
            app:backgroundTint="@color/fg_primary_soft"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_sheet_assess"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Assess Flap"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@color/fg_primary"
            app:cornerRadius="12dp" />
    </LinearLayout>
</LinearLayout>
