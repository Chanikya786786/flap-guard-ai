<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/fg_surface"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="12dp"
    android:paddingEnd="22dp"
    android:paddingBottom="28dp">

    <View
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_sheet_handle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="Clinical Crisis Simulator"
        android:textColor="@color/fg_text_primary"
        android:textSize="20sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="18dp"
        android:text="Simulate progressive vascular compromise for live demonstration and alert testing."
        android:textColor="@color/fg_text_muted"
        android:textSize="13sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_sim_venous"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="10dp"
        android:text="Simulate Venous Congestion"
        android:textAllCaps="false"
        android:textColor="@color/fg_warning"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="@color/fg_warning_bg"
        app:cornerRadius="14dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_sim_arterial"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Simulate Arterial Ischemia"
        android:textAllCaps="false"
        android:textColor="@color/fg_danger"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="@color/fg_danger_bg"
        app:cornerRadius="14dp" />
</LinearLayout>
