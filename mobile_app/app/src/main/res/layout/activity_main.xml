<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FB"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tv_app_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FlapGuard AI"
            android:textColor="#0B2545"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Early Free-Flap Failure Prediction &amp; Real-Time Surgeon Alerts"
            android:textColor="#475569"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Server URL (USB default: http://127.0.0.1:5000)"
                android:textColor="#334155"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_server_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="http://127.0.0.1:5000"
                android:inputType="textUri"
                android:text="http://127.0.0.1:5000" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_mode_login"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="#0F4C81"
                    android:text="Sign In" />

                <Button
                    android:id="@+id/btn_mode_register"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:backgroundTint="#64748B"
                    android:text="Sign Up" />
            </LinearLayout>

            <EditText
                android:id="@+id/et_full_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:hint="Full Name (e.g., Dr. Alden)"
                android:inputType="textPersonName"
                android:visibility="gone" />

            <Spinner
                android:id="@+id/spinner_role"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/et_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:hint="Clinician Email"
                android:inputType="textEmailAddress" />

            <EditText
                android:id="@+id/et_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="Password (min 8 chars)"
                android:inputType="textPassword" />

            <Button
                android:id="@+id/btn_auth_submit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#0F4C81"
                android:text="Sign In" />

            <Button
                android:id="@+id/btn_demo_fill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#15803D"
                android:text="Auto-Fill Demo Surgeon Login" />

            <TextView
                android:id="@+id/tv_auth_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Ready. Connect via USB (adb reverse) or cloud URL."
                android:textColor="#475569"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>