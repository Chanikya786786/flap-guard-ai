<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:background="@color/fg_bg" android:fillViewport="true" android:layout_height="match_parent" android:layout_width="match_parent" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="vertical" android:padding="24dp">

        <RelativeLayout android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:layout_marginTop="8dp" android:layout_width="match_parent">

            <TextView android:background="@drawable/bg_badge" android:backgroundTint="@color/fg_primary_soft" android:id="@+id/tv_connection_pill" android:layout_alignParentStart="true" android:layout_centerVertical="true" android:layout_height="wrap_content" android:layout_width="wrap_content" android:paddingBottom="5dp" android:paddingEnd="12dp" android:paddingStart="12dp" android:paddingTop="5dp" android:text="Cloud Connected" android:textColor="@color/fg_primary" android:textSize="11sp" android:textStyle="bold"/>

            <ImageButton android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Connection settings" android:id="@+id/btn_connection_settings" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:layout_height="36dp" android:layout_width="36dp" android:src="@drawable/ic_settings" app:tint="@color/fg_text_muted"/>
        </RelativeLayout>

        <TextView android:layout_height="wrap_content" android:layout_width="wrap_content" android:text="FlapGuard AI" android:textColor="@color/fg_primary" android:textSize="30sp" android:textStyle="bold"/>

        <TextView android:layout_height="wrap_content" android:layout_marginBottom="24dp" android:layout_marginTop="4dp" android:layout_width="wrap_content" android:text="OMFS &amp; Microsurgical Post-Op Free-Flap Monitoring" android:textColor="@color/fg_text_secondary" android:textSize="14sp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/fg_surface"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/fg_border"
            app:strokeWidth="1dp">

            <LinearLayout android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="vertical" android:padding="20dp">

                <LinearLayout android:layout_height="wrap_content" android:layout_marginBottom="18dp" android:layout_width="match_parent" android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_mode_login"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="Sign In"
                        android:textAllCaps="false"
                        app:backgroundTint="@color/fg_primary"
                        app:cornerRadius="10dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_mode_register"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="Create Account"
                        android:textAllCaps="false"
                        android:textColor="@color/fg_text_secondary"
                        app:backgroundTint="@color/fg_bg"
                        app:cornerRadius="10dp" />
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_full_name"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="Clinician Full Name"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_full_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout android:id="@+id/layout_role_container" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:layout_width="match_parent" android:orientation="vertical" android:visibility="gone">

                    <TextView android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:layout_width="wrap_content" android:text="Clinical Role" android:textColor="@color/fg_text_secondary" android:textSize="12sp" android:textStyle="bold"/>

                    <Spinner android:id="@+id/spinner_role" android:layout_height="46dp" android:layout_width="match_parent"/>
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="Hospital Email">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp"
                    android:hint="Password"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_auth_submit"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Sign In"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/fg_primary"
                    app:cornerRadius="12dp" />

                <ProgressBar android:id="@+id/progress_auth" android:layout_gravity="center_horizontal" android:layout_height="28dp" android:layout_marginTop="12dp" android:layout_width="28dp" android:visibility="gone"/>

                <TextView android:gravity="center" android:id="@+id/tv_auth_status" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:layout_width="match_parent" android:text="" android:textColor="@color/fg_text_secondary" android:textSize="13sp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView android:gravity="center" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:layout_width="match_parent" android:text="For Oral &amp; Maxillofacial Surgeons and Post-Op ICU Nurses.\nDecision support only — always confirm clinically." android:textColor="@color/fg_text_muted" android:textSize="12sp"/>
    </LinearLayout>
</ScrollView>
