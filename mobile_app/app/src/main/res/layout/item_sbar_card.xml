<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_sbar_patient"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/fg_surface"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/fg_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="15dp">

        <!-- Card Header: Rank + Patient Name + Risk Pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_sbar_rank"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_circle_soft"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/fg_primary_text"
                android:textSize="11.5sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_sbar_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Patient Name"
                    android:textColor="@color/fg_text_primary"
                    android:textSize="15.5sp" />

                <TextView
                    android:id="@+id/tv_sbar_mrn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="MRN-2026-102"
                    android:textColor="@color/fg_text_muted"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_sbar_tier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:text="Critical"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_sbar_sched"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_badge"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="9dp"
            android:paddingTop="3dp"
            android:paddingEnd="9dp"
            android:paddingBottom="3dp"
            android:text=""
            android:textSize="11sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="11dp"
            android:layout_marginBottom="10dp"
            android:background="@color/fg_divider" />

        <!-- S: Situation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_badge"
                android:backgroundTint="@color/fg_primary_soft"
                android:gravity="center"
                android:text="S"
                android:textColor="@color/fg_primary_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_sbar_s"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:lineSpacingMultiplier="1.15"
                android:textColor="@color/fg_text_primary"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- B: Background -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_badge"
                android:backgroundTint="@color/fg_surface_soft"
                android:gravity="center"
                android:text="B"
                android:textColor="@color/fg_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_sbar_b"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:lineSpacingMultiplier="1.15"
                android:textColor="@color/fg_text_secondary"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- A: Assessment -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_badge"
                android:backgroundTint="@color/fg_accent_soft"
                android:gravity="center"
                android:text="A"
                android:textColor="@color/fg_accent"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_sbar_a"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:lineSpacingMultiplier="1.15"
                android:textColor="@color/fg_text_secondary"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- R: Recommendation Action Strip -->
        <LinearLayout
            android:id="@+id/box_sbar_r"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_metric_tile"
            android:orientation="horizontal"
            android:padding="10dp">

            <TextView
                android:id="@+id/tv_sbar_r_badge"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="9dp"
                android:background="@drawable/bg_badge"
                android:gravity="center"
                android:text="R"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_sbar_r"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingMultiplier="1.15"
                android:textColor="@color/fg_text_primary"
                android:textSize="12.5sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
