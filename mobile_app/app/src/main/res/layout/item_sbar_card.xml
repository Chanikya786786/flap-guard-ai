<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_sbar_patient"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/fg_surface"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/fg_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Header: Priority Rank, Name, MRN & Risk Pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_sbar_rank"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_circle_soft"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/fg_primary_text"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_sbar_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Patient Name"
                    android:textColor="@color/fg_text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tv_sbar_mrn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:text="MRN-2026-102"
                    android:textColor="@color/fg_text_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_sbar_tier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge"
                android:paddingStart="9dp"
                android:paddingTop="2.5dp"
                android:paddingEnd="9dp"
                android:paddingBottom="2.5dp"
                android:text="Critical"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Protocol & OOD Strip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_sbar_sched"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_badge"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:paddingStart="8dp"
                android:paddingTop="2.5dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2.5dp"
                android:text=""
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/tv_sbar_ood"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge"
                android:backgroundTint="@color/fg_warning_bg"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="8dp"
                android:paddingTop="2.5dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2.5dp"
                android:text="Verify Probe (OOD)"
                android:textColor="@color/fg_warning"
                android:textSize="10.5sp"
                android:visibility="gone" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="9dp"
            android:layout_marginBottom="9dp"
            android:background="@color/fg_divider" />

        <!-- S: Concise Clinical Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="7dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="1dp"
                android:layout_marginEnd="9dp"
                android:background="@drawable/bg_badge"
                android:backgroundTint="@color/fg_primary_soft"
                android:gravity="center"
                android:text="S"
                android:textColor="@color/fg_primary_text"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_sbar_s"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:includeFontPadding="true"
                android:lineSpacingMultiplier="1.2"
                android:textColor="@color/fg_text_primary"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- B: Flap & Post-Op Context -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="1dp"
                android:layout_marginEnd="9dp"
                android:background="@drawable/bg_badge"
                android:backgroundTint="@color/fg_surface_soft"
                android:gravity="center"
                android:text="B"
                android:textColor="@color/fg_text_secondary"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_sbar_b"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="true"
                android:lineSpacingMultiplier="1.2"
                android:textColor="@color/fg_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- A: Structured Tabular Vitals + Exam (Zero Pipe-Wall Clipping) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="9dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="9dp"
                android:background="@drawable/bg_badge"
                android:backgroundTint="@color/fg_accent_soft"
                android:gravity="center"
                android:text="A"
                android:textColor="@color/fg_accent"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/ll_sbar_vitals_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ΔT"
                            android:textColor="@color/fg_text_muted"
                            android:textSize="9.5sp" />

                        <TextView
                            android:id="@+id/tv_sbar_v_delta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:fontFeatureSettings="tnum"
                            android:textColor="@color/fg_text_primary"
                            android:textSize="12.5sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SpO₂"
                            android:textColor="@color/fg_text_muted"
                            android:textSize="9.5sp" />

                        <TextView
                            android:id="@+id/tv_sbar_v_spo2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:fontFeatureSettings="tnum"
                            android:textColor="@color/fg_text_primary"
                            android:textSize="12.5sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.15"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Doppler"
                            android:textColor="@color/fg_text_muted"
                            android:textSize="9.5sp" />

                        <TextView
                            android:id="@+id/tv_sbar_v_doppler"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:fontFeatureSettings="tnum"
                            android:textColor="@color/fg_text_primary"
                            android:textSize="12.5sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.85"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Visual"
                            android:textColor="@color/fg_text_muted"
                            android:textSize="9.5sp" />

                        <TextView
                            android:id="@+id/tv_sbar_v_visual"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:fontFeatureSettings="tnum"
                            android:textColor="@color/fg_text_primary"
                            android:textSize="12.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_sbar_a"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="true"
                    android:lineSpacingMultiplier="1.2"
                    android:textColor="@color/fg_text_secondary"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- R: Actionable Recommendation Strip -->
        <LinearLayout
            android:id="@+id/box_sbar_r"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_metric_tile"
            android:orientation="horizontal"
            android:padding="10dp">

            <TextView
                android:id="@+id/tv_sbar_r_badge"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="1dp"
                android:layout_marginEnd="9dp"
                android:background="@drawable/bg_badge"
                android:gravity="center"
                android:text="R"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_sbar_r"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="true"
                android:lineSpacingMultiplier="1.2"
                android:textColor="@color/fg_text_primary"
                android:textSize="12.5sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
