<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/fg_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp">

        <View
            android:layout_width="38dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_sheet_handle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Record Confirmed Diagnosis"
            android:textColor="@color/fg_text_primary"
            android:textSize="19sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="10dp"
            android:text="Verified bedside or OR findings improve continuous model accuracy."
            android:textColor="@color/fg_text_muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:fontFamily="sans-serif-medium"
            android:text="PATIENT"
            android:textColor="@color/fg_text_muted"
            android:textSize="10.5sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_vital_input"
            android:paddingStart="10dp"
            android:paddingEnd="6dp">

            <Spinner
                android:id="@+id/spinner_outcome_patient_sheet"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="sans-serif-medium"
            android:text="CONFIRMED CLINICAL OUTCOME"
            android:textColor="@color/fg_text_muted"
            android:textSize="10.5sp" />

        <LinearLayout
            android:id="@+id/chip_group_outcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/chip_outcome_normal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_vital_input"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="11dp"
                    android:background="@drawable/bg_status_bar"
                    android:backgroundTint="@color/fg_success" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_outcome_normal_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Normal"
                        android:textColor="@color/fg_text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Healthy perfusion, viable free flap"
                        android:textColor="@color/fg_text_muted"
                        android:textSize="11.5sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chip_outcome_venous"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_vital_input"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="11dp"
                    android:background="@drawable/bg_status_bar"
                    android:backgroundTint="@color/fg_warning" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_outcome_venous_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Venous Compromise"
                        android:textColor="@color/fg_text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Congestion, dark ooze, brisk refill"
                        android:textColor="@color/fg_text_muted"
                        android:textSize="11.5sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chip_outcome_arterial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_vital_input"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="11dp"
                    android:background="@drawable/bg_status_bar"
                    android:backgroundTint="@color/fg_danger" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_outcome_arterial_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Arterial Compromise"
                        android:textColor="@color/fg_text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pallor, cool flap, sluggish/absent inflow"
                        android:textColor="@color/fg_text_muted"
                        android:textSize="11.5sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:fontFamily="sans-serif-medium"
            android:text="SURGEON NOTES (OPTIONAL)"
            android:textColor="@color/fg_text_muted"
            android:textSize="10.5sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_vital_input"
            android:padding="12dp">

            <EditText
                android:id="@+id/et_outcome_notes_sheet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:contentDescription="outcome_notes_input"
                android:gravity="top|start"
                android:hint="Intra-op findings, anastomosis status, or bedside notes..."
                android:inputType="textMultiLine"
                android:minLines="2"
                android:textColor="@color/fg_text_primary"
                android:textColorHint="@color/fg_text_muted"
                android:textSize="13.5sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_outcome_sheet"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Save Verified Outcome"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14.5sp"
            android:textStyle="bold"
            app:backgroundTint="@color/fg_primary"
            app:cornerRadius="14dp"
            app:elevation="0dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
