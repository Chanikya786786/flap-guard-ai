<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/fg_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="12dp"
        android:paddingEnd="22dp"
        android:paddingBottom="24dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_sheet_handle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Log Verified Post-Op Outcome"
            android:textColor="@color/fg_text_primary"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="14dp"
            android:text="Ground-truth surgical confirmation feeds continuous AI learning."
            android:textColor="@color/fg_text_muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Patient"
            android:textColor="@color/fg_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinner_outcome_patient_sheet"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Confirmed Clinical Outcome"
            android:textColor="@color/fg_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_outcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_outcome_normal"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Normal"
                android:textColor="@color/selector_chip_text"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/selector_chip_bg"
                app:chipStrokeColor="@color/fg_border_strong" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_outcome_venous"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Venous Compromise"
                android:textColor="@color/selector_chip_text"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/selector_chip_bg"
                app:chipStrokeColor="@color/fg_border_strong" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_outcome_arterial"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Arterial Compromise"
                android:textColor="@color/selector_chip_text"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/selector_chip_bg"
                app:chipStrokeColor="@color/fg_border_strong" />
        </com.google.android.material.chip.ChipGroup>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Surgeon / Intraoperative Notes"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:placeholderText="Optional clinical follow-up details">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_outcome_notes_sheet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="outcome_notes_input"
                android:inputType="textMultiLine"
                android:minLines="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_outcome_sheet"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Save Outcome"
            android:textAllCaps="false"
            android:textStyle="bold"
            app:backgroundTint="@color/fg_primary"
            app:cornerRadius="12dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
