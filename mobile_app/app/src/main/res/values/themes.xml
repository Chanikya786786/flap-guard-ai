<resources>
    <style name="Base.Theme.FlapGuardAI" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/fg_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/fg_primary_soft</item>
        <item name="colorOnPrimaryContainer">@color/fg_primary_text</item>
        <item name="colorSecondary">@color/fg_accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/fg_primary_soft</item>
        <item name="colorOnSecondaryContainer">@color/fg_primary_text</item>
        <item name="colorSurface">@color/fg_surface</item>
        <item name="colorOnSurface">@color/fg_text_primary</item>
        <item name="colorSurfaceVariant">@color/fg_surface_soft</item>
        <item name="colorOnSurfaceVariant">@color/fg_text_secondary</item>
        <item name="colorOutline">@color/fg_border</item>
        <item name="materialSwitchStyle">@style/Widget.FlapGuard.Switch</item>
        <item name="android:windowBackground">@color/fg_bg</item>
        <item name="android:statusBarColor">@color/fg_surface</item>
        <item name="android:navigationBarColor">@color/fg_surface</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.FlapGuardAI" parent="Base.Theme.FlapGuardAI" />

    <style name="Widget.FlapGuard.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="trackTint">@color/switch_track_tint</item>
        <item name="thumbTint">@color/switch_thumb_tint</item>
        <item name="trackDecorationTint">@color/fg_border_strong</item>
    </style>

    <style name="Widget.FlapGuard.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/fg_primary_soft</item>
    </style>

    <style name="Widget.FlapGuard.InputFilled" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/fg_input_bg</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="boxStrokeColor">@color/fg_primary_text</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintTextColor">@color/fg_text_muted</item>
    </style>
</resources>
